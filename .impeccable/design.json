  "narrative": {
    "northStar": "O Quadro de Resultados",
    "overview": "O TokArena é uma sala de controle de arena construída como o quadro de resultados de uma corrida. O preto domina; o vermelho aparece só onde algo está ao vivo, ativo, selecionado ou liderando. Os jogos e os personagens são o centro, e o painel é o apoio.",
    "keyCharacteristics": [
      "Preto quase puro com painéis em degraus e filetes finos.",
      "Numerais de placar em Barlow Condensed, sempre tabulares.",
      "Réguas de raia (tracejado fino) como divisor.",
      "Chanfro de 45° em placas não interativas.",
      "Vermelho como única cor de marca; verde e âmbar só como estado."
    ],
    "rules": [
      {
        "name": "The Leader Red Rule",
        "body": "O vermelho marca ao vivo, ativo, selecionado ou líder. Se tudo é vermelho, nada é líder.",
        "section": "colors"
      },
      {
        "name": "The Ink Rule",
        "body": "Texto vermelho pequeno usa #ff5c68, nunca #e32636 (3.9:1 no painel).",
        "section": "colors"
      },
      {
        "name": "The Scoreboard Numerals Rule",
        "body": "Todo número que muda ou compara usa Barlow tabular ou tabular-nums.",
        "section": "typography"
      },
      {
        "name": "The Lane Rule",
        "body": "Linhas de lista e de dados são separadas por tracejado fino, como divisórias de raia.",
        "section": "layout"
      },
      {
        "name": "The Chamfer Rule",
        "body": "O chanfro marca superfícies que não recebem foco; botões e campos mantêm o raio comum.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do usar #ffffff sobre vermelho e #ff5c68 para texto vermelho pequeno.",
      "Do separar linhas com tracejado fino e usar numerais tabulares para dados.",
      "Do escrever \"demonstração\" onde houver dado simulado.",
      "Do usar container queries nos layouts de página."
    ],
    "donts": [
      "Don't usar vermelho como decoração ou em todos os elementos.",
      "Don't usar kicker/eyebrow acima de títulos, faixa lateral colorida, texto com gradiente nem sombras de deslocamento duro.",
      "Don't usar emojis ou símbolos Unicode como ícones.",
      "Don't aplicar clip-path a elementos focáveis."
    ]
  }
}