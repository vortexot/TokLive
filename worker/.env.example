# Copie este arquivo para worker/.env e preencha. O worker/.env fica fora do Git.

# Chave da API da Anthropic (console.anthropic.com). Sem ela, o palco fala só com o roteiro.
ANTHROPIC_API_KEY=

# Modelo das falas. Padrão: claude-opus-5-5. Para respostas mais rápidas e baratas: claude-haiku-5-5.
PALCO_MODELO=

# Porta da ponte no seu computador. Padrão: 8787.
PALCO_PORTA=

# @ da sua LIVE, se não quiser digitar no comando.
PALCO_TIKTOK=

# Chave opcional do Euler Stream (usada pela biblioteca do TikTok para assinar as conexões).
EULER_SIGN_API_KEY=
