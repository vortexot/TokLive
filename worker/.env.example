# Copie este arquivo para worker/.env e preencha. O worker/.env fica fora do Git.

# Qual IA dá voz aos bonecos. Deixe vazio para usar a Anthropic (com a chave abaixo).
# "ollama" usa um modelo no seu próprio computador (o mesmo da Mentiliza): sem chave e sem custo por fala.
PALCO_IA=

# Só com PALCO_IA=ollama. Endereço do Ollama (precisa ser o próprio computador). Padrão: http://127.0.0.1:11434.
OLLAMA_URL=

# Só com PALCO_IA=ollama. Modelo instalado no Ollama. Padrão: qwen2.5:3b (instale com: ollama pull qwen2.5:3b).
OLLAMA_MODELO=

# Chave da API da Anthropic (console.anthropic.com). Sem ela e sem PALCO_IA=ollama, o palco fala só com o roteiro.
ANTHROPIC_API_KEY=

# Modelo das falas. Padrão: claude-opus-5-5. Para respostas mais rápidas e baratas: claude-haiku-5-5.
PALCO_MODELO=

# Porta da ponte no seu computador. Padrão: 8787.
PALCO_PORTA=

# @ da sua LIVE, se não quiser digitar no comando.
PALCO_TIKTOK=

# Chave opcional do Euler Stream (usada pela biblioteca do TikTok para assinar as conexões).
EULER_SIGN_API_KEY=
